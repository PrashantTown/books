# Copy this file to .env and fill it in. Never commit .env.

# --- Required ---------------------------------------------------------------

# MongoDB connection string. For MongoDB Atlas it looks like:
# mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/parentsgoto?retryWrites=true&w=majority
# For a local MongoDB: mongodb://127.0.0.1:27017/parentsgoto
MONGODB_URI=

# Long random string used to sign sign-in tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Optional ---------------------------------------------------------------

# Port the API listens on (hosting platforms usually set this for you).
PORT=5000

# Websites allowed to call the API, comma-separated, no trailing slash.
# Leave empty during local development to allow everything.
# CORS_ORIGINS=https://parents-go-to.vercel.app,http://localhost:5500

# Six-digit code administrators enter after their password, used only while
# email (below) isn't set up. Leave empty to switch the second step off.
ADMIN_LOGIN_CODE=

# Email, through brevo.com (free: 300 emails a day, no domain needed). With
# these set, "Forgot your password?" emails a reset link, new accounts
# confirm their email address, and every administrator sign-in emails a fresh
# six-digit code to that administrator. MAIL_FROM must be a sender you have
# verified in Brevo. (RESEND_API_KEY works instead of BREVO_API_KEY.)
# BREVO_API_KEY=
# MAIL_FROM=you@example.com
# MAIL_FROM_NAME=Parents Go To
# MAIL_PROVIDER=log        print emails to the console instead (local testing)

# Who receives contact-page messages and problem reports by email, comma
# separated. Leave empty to send them to every active administrator.
# SUPPORT_EMAIL=

# The site that links in emails open, when the request didn't come from one
# of the CORS_ORIGINS sites (they normally do).
# SITE_URL=https://parents-go-to-live.vercel.app

# Set to 1 when the API runs behind a hosting proxy (Render, Railway, Heroku)
# so rate limits see each visitor's real address.
# TRUST_PROXY=1

# Rate limits per visitor address (defaults shown). Raise them if a school or
# library network puts many families behind one address.
# RATE_LIMIT_LOGIN=50      sign-in attempts per 15 minutes
# RATE_LIMIT_SIGNUP=20     new accounts per hour
# RATE_LIMIT_FORGOT=10     password reset requests per hour
# RATE_LIMIT_CONTACT=15    contact-form messages per hour

# Demo accounts created by `npm run seed` (defaults shown).
# SEED_ADMIN_EMAIL=admin@parentsgoto.test
# SEED_ADMIN_PASSWORD=demo1234-admin
# SEED_PARENT_EMAIL=demo@parentsgoto.test
# SEED_PARENT_PASSWORD=demo1234
